#include <winuser.h>

#ifndef CREATEPROCESS_MANIFEST_RESOURCE_ID
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#endif
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

// MinGW links no manifest by itself, so without this the binary got neither
// Common Controls v6 (hence the Windows-95 looking preferences dialog) nor the
// per-monitor DPI declaration.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "../app.manifest"
